<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\QuotaRing.Core\QuotaRing.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>QuotaRing</AssemblyName>
    <RootNamespace>QuotaRing</RootNamespace>
    <AssemblyTitle>QuotaRing</AssemblyTitle>
    <Product>QuotaRing</Product>
    <Description>Windows 工作列 Claude Code 與 Codex 額度監測與帳號切換</Description>
    <RepositoryUrl>https://github.com/g32jcj86/my-ai-quota-ring</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>zh-TW</NeutralLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" />
  </ItemGroup>

</Project>
